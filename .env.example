# Supabase — required for auth and analytics
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat — IAP and subscription management
# Test key must start with "test_" (used in Expo Go / dev)
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=test_your_key_here
# Platform keys used in native iOS/Android builds
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_key_here
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_key_here

# Google AdMob — ad unit IDs (NOT the app IDs, which live in app.json plugins)
# Find these in the AdMob console: Apps > your app > Ad units
EXPO_PUBLIC_ADMOB_IOS_AD_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_ADMOB_ANDROID_AD_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
